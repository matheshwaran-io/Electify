# ==============================================================================
# ELECTIFY ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to `.env` or `.env.local` and fill in your values.
# For Vercel deployment: Set these variables in Project Settings > Environment Variables.

# 1. DATABASE CONFIGURATION (PostgreSQL)
# ------------------------------------------------------------------------------
# DATABASE_URL: Pooled connection string (e.g. Supabase port 6543 / Neon pooled connection)
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# DIRECT_URL: Direct connection string (Required for running migrations and Drizzle Kit)
DIRECT_URL="postgresql://postgres:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"


# 2. AUTHENTICATION & SECURITY
# ------------------------------------------------------------------------------
# JWT_SECRET: Secure secret for signed session cookies (Must be at least 32 characters)
# Generate one with: openssl rand -base64 32
JWT_SECRET="generate-a-secure-random-secret-at-least-32-chars-long"

# SETUP_SECRET: Required in production to authorize admin account bootstrapping via /api/health?setup=true
SETUP_SECRET="generate-a-secure-random-setup-secret"

# INITIAL_ADMIN_PASSWORD: Optional initial password for bootstrap admin (defaults to strong fallback if omitted)
INITIAL_ADMIN_PASSWORD="ChangeThisAdminPass!2026"


# 3. APPLICATION & CANONICAL URL
# ------------------------------------------------------------------------------
# NEXT_PUBLIC_APP_URL: Canonical application domain used for metadataBase and social previews
NEXT_PUBLIC_APP_URL="https://electify.srmist.edu.in"


# 4. SUPABASE REALTIME & CLIENT CONFIGURATION
# ------------------------------------------------------------------------------
# Found in Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_..."


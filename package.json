    "db:migrate:subject-profiles": "tsx --env-file=.env.local scripts/db/apply-sql.ts drizzle/0005_subject_profiles.sql",
    "db:migrate:academic-sessions": "tsx --env-file=.env.local scripts/db/apply-sql.ts drizzle/0006_academic_sessions.sql",

    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/lib/db/seed.ts",
    "db:reset": "tsx src/lib/db/reset.ts",
    "db:clean": "tsx scripts/cleanup-mock-data.ts",
    "fix:passwords": "tsx scripts/fix-passwords.ts",
    "brand:generate": "tsx scripts/brand/generate-brand-assets.ts",
